# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set to the number of reverse proxies in front of the app (0 = none).
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Database (MySQL 8.0.19+)
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://nepse:change-me@localhost:3306/nepse
# Only used by `npm run test:integration`. The database name MUST end in _test.
TEST_DATABASE_URL=mysql://nepse:change-me@localhost:3306/nepse_test

# ---------------------------------------------------------------------------
# HTTP API
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins, or * for any origin.
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=100kb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# NEPSE provider (unofficial nepalstock.com.np web endpoints)
# ---------------------------------------------------------------------------
NEPSE_BASE_URL=https://nepalstock.com.np
PROVIDER_TIMEOUT_MS=15000
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_MS=1000
# Upper bound for honouring a Retry-After header; longer waits fail the request.
PROVIDER_MAX_RETRY_DELAY_MS=30000
# Minimum spacing between request starts, across all concurrent workers.
PROVIDER_MIN_INTERVAL_MS=300
# How long a prove/market-open session is reused before being refreshed.
PROVIDER_SESSION_TTL_MS=60000

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
SYNC_CONCURRENCY=3
SYNC_BATCH_SIZE=50
# Optional comma-separated watchlist; empty = every active instrument.
SYNC_SYMBOLS=
# Abort a sync after this many consecutive upstream failures.
SYNC_MAX_CONSECUTIVE_FAILURES=10
# In-process scheduler. 0 disables it (use an external scheduler instead).
SYNC_INTERVAL_MINUTES=0
INGESTION_LOCK_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# Quotes
# ---------------------------------------------------------------------------
# A stored quote older than this is reported as stale.
QUOTE_MAX_AGE_SECONDS=300
# When true, GET /quote refreshes a stale quote from NEPSE on demand.
QUOTE_ON_DEMAND_REFRESH=false
